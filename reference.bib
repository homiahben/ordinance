	year = {2013},
	keywords = {Africa, Garden cities, Administration of Urban Planning and Community and Rural Development, History, History of imperialism, Land Subdivision, Race discrimination in housing, Sub-Saharan Africa, Urban planning, Zimbabwe},
	pages = {477--485},
	file = {Full text PDF:/Users/ebenyiah/Zotero/storage/SE9RV62Y/Bigon - 2013 - Garden cities in colonial Africa a note on historiography..pdf:application/pdf},
}


@book{hart_making_2024,
	title = {Making an {African} {City}: {Technopolitics} and the {Infrastructure} of {Everyday} {Life} in {Colonial} {Accra}},
	isbn = {978-0-253-06932-0},
	shorttitle = {Making an {African} {City}},
	url = {https://www.jstor.org/stable/jj.10860916},
	doi = {10.2307/jj.10860916},
	abstract = {In  \textit{Making an African City} , Jennifer Hart traces the way
that British colonial officials, Accra Town Council members, and a
diverse group of technocrats used regulation to define what an
"acceptable" city looked like. Unlike cities elsewhere on the
continent, Accra had a long history of urbanism that predated
British colonial presence. By criminalizing some activities and
privileging others, colonial officials sought to marginalize
indigenous practices of Accra residents and shape the development
of a new, "modern" city.

Hart argues, however, that residents regularly pushed back,
protesting regulations, refusing to participate in newly developed
systems, reappropriating infrastructure, demanding rights to city
services, and asserting their own informal vision for the future of
the city. While urban plans and regulations ultimately failed to
substantively remake the city, their effects were and are still
felt by urban residents, who are often subject to but not served by
urban infrastructure.

 \textit{Making an African City}  explores how the informalization
of Accra's development was a historical process, not a natural and
self-evident phenomenon, which connects the history of the city
with the history of urban development and the growth of technocracy
around the world.},
	urldate = {2026-04-02},
	publisher = {Indiana University Press},
	author = {Hart, Jennifer},
	year = {2024},
}


